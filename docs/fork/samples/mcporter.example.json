{
  "mcpServers": {
    "tavily": {
      "description": "Tavily web search MCP for backup when minimax web_search fails",
      "command": "npx",
      "args": [
        "--yes",
        "tavily-mcp"
      ],
      "env": {
        "TAVILY_API_KEY": ""
      }
    },
    "minimax": {
      "command": "uvx",
      "args": [
        "minimax-coding-plan-mcp",
        "-y"
      ],
      "description": "MiniMax Token Plan MCP for image understanding and web search",
      "env": {
        "MINIMAX_API_KEY": "",
        "MINIMAX_API_HOST": ""
      }
    }
  },
  "imports": []
}
